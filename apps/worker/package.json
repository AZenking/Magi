{
  "name": "@magi/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "dev": "bash ../../scripts/with-env.sh tsx watch src/main.ts",
    "start": "bash ../../scripts/with-env.sh node dist/main.js",
