    "ioredis": "^5.6.1",
    "postgres": "^3.4.7",
    "zod": "^3.25.42"
  },
  "devDependencies": {
    "@magi/tsconfig": "workspace:*",
    "@types/node": "^22.15.29",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  }
}
