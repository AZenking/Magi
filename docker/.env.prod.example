# Copy to docker/.env.prod, then replace every example value before deploy.
# Use URL-safe/hex passwords because they are embedded in DATABASE_URL/REDIS_URL.

# PostgreSQL
POSTGRES_USER=magi
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password
POSTGRES_DB=magi
REDIS_PASSWORD=replace-with-a-different-long-random-hex-password

# GitHub Container Registry images for docker-compose.server.yml.
# Use `latest` for the newest successful master build, or pin IMAGE_TAG to
# `sha-<commit>` for a reproducible rollback.
IMAGE_PREFIX=ghcr.io/azenking
IMAGE_TAG=latest

# Public URLs. PUBLIC_API_HOST is hostname only, without https://.
API_PORT=3001
WEB_PORT=3000
WEB_ORIGIN=https://magi.example.com
BETTER_AUTH_SECRET=replace-with-a-random-32-byte-secret
BETTER_AUTH_URL=https://api.magi.example.com
PUBLIC_API_HOST=api.magi.example.com
# Leave blank only when Web and API are accessed directly on the same host.
VITE_API_URL=https://api.magi.example.com
SCHEDULE_STREAM_CHECK=300000
LOG_LEVEL=info

# Administrator account. Run MAGI_SEED=1 bash scripts/deploy.sh once to create it.
MAGI_ADMIN_USERNAME=admin
MAGI_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
MAGI_ADMIN_EMAIL=admin@magi.example.com
MAGI_ADMIN_NAME=Admin
