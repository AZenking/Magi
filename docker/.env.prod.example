# Magi 生产环境配置

# PostgreSQL（生产环境务必修改密码）
POSTGRES_USER=magi
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=magi

# API
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string
BETTER_AUTH_URL=http://localhost:3001

# Web
WEB_PORT=3000
# Optional. Leave empty to use the current browser host with API_PORT.
VITE_API_URL=

# 管理员账号（首次 seed 时使用）
MAGI_ADMIN_USERNAME=admin
MAGI_ADMIN_PASSWORD=change-me-to-a-strong-password
MAGI_ADMIN_EMAIL=admin@magi.local
MAGI_ADMIN_NAME=Admin

# 镜像版本（对应 package.json version，留空使用 latest）
# MAGI_VERSION=0.1.0
