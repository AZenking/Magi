# PostgreSQL
POSTGRES_USER=magi
POSTGRES_PASSWORD=magi
POSTGRES_DB=magi
POSTGRES_PORT=15432

# Redis
REDIS_HOST=localhost
REDIS_PORT=16379
# Used by apps/api in dev (pnpm dev). Container scene overrides this via docker-compose.yml.
REDIS_URL=redis://localhost:16379

# API
API_PORT=3001
DATABASE_URL=postgres://magi:magi@localhost:15432/magi

# Local storage roots (dev only). Containers use /app/... defaults in code.
LOGO_UPLOAD_DIR=./.data/uploads/logos
BACKUP_STORAGE_ROOT=./.data/backups

# Web
WEB_PORT=3000
# Optional. Leave empty to use the current browser host with API_PORT.
VITE_API_URL=
WEB_ORIGIN=http://localhost:3000

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string
BETTER_AUTH_URL=http://localhost:3001

# Admin seed (used by pnpm --filter @magi/api seed)
MAGI_ADMIN_USERNAME=admin
MAGI_ADMIN_PASSWORD=zxcv1234
MAGI_ADMIN_EMAIL=admin@magi.local
MAGI_ADMIN_NAME=Admin

# Safe Operations rollout (004-safe-operations-workflow). All defaults are OFF.
# See specs/004-safe-operations-workflow/rollout-runbook.md before enabling.
SAFE_OPS_SHADOW_PREVIEW=false
SAFE_OPS_ENABLE_NEW_WRITE_SOURCE_IDS=
SAFE_OPS_ENABLE_NEW_WRITE_ALL=false
