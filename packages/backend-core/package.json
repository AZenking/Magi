{
  "name": "@magi/backend-core",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./processors/failover-policy": {
      "types": "./dist/processors/failover-policy.d.ts",
      "default": "./dist/processors/failover-policy.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
